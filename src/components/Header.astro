---
const nav = [
  { href: "/", label: "Home" },
  { href: "/dashboard", label: "Dashboard" },
  { href: "/methodology", label: "Methodology" },
  {
    href: "https://australia-cgt-reform-calculator.setiyaputra.me",
    label: "CGT Calculator",
    external: true
  }
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/">
      <span class="brand-mark">B</span>
      <span>
        <strong>Budget 2026 Claims Monitor</strong>
        <small>Budget 2026 tax claim analysis</small>
      </span>
    </a>
    <nav class="nav">
      {nav.map((item) => (
        <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noreferrer" : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
